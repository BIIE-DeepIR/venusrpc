// venusrpc_host.hsl
// HSL HTTP client that communicates with the Python-side venusrpc Connection.
//
// Lifecycle:
//   1. Read venusrpc.port from the same directory as this script.
//   2. Build base URL: http://127.0.0.1:<port>
//   3. POST /ready to signal startup.
//   4. Loop: GET /command -> execute -> POST /result
//   5. Exit when ___SHUTDOWN___ is set by executed code.
//
// Payload format (Python -> HSL via GET /command body):
//   <cmd_id>\n\n___SEP___\n
// HSL command source is loaded from the stamped command-file prefix below.
//
// ============================================================================

#include "HSLHttp\HSLHttp.hsl"
#include "HSLExtensions\File.hsl"
#include "HSLStrLib.hsl"

namespace venusrpc {
   variable strScriptDir;
   variable strPortFile;
   variable strBaseUrl;
   object objHttp;
}

variable ___SHUTDOWN___(0);
variable ___JSON___;
variable ___ERROR___(0);
device __DEVICE__("", "", hslTrue);


// ----------------------------------------------------------------------------
// JSON building helpers (mirrored to Python side via json.loads).
// ----------------------------------------------------------------------------

function StrEscape(variable s) variable {
   StrReplace(s, "\\", "\\\\");
   StrReplace(s, "\"", "\\\"");
   StrReplace(s, "\n", "\\n");
   StrReplace(s, "\r", "\\r");
   StrReplace(s, "\t", "\\t");
   return(s);
}

function JsonObjStart(variable & j, variable name) void {
   if (name != "") j = j + "\"" + name + "\":";
   j = j + "{";
}

function JsonObjEnd(variable & j) void {
   j = StrTrimRight(j, ",");
   j = j + "},";
}

function JsonProp(variable & j, variable name, variable value) void {
   if (GetType(value) == "i")
      j = j + "\"" + name + "\":" + IStr(value) + ",";
   if (GetType(value) == "f")
      j = j + "\"" + name + "\":" + FStr(value) + ",";
   if (GetType(value) == "s")
      j = j + "\"" + name + "\":\"" + StrEscape(value) + "\",";
}

function JsonArrStart(variable & j, variable name) void {
   j = j + "\"" + name + "\":[";
}

function JsonArrEnd(variable & j) void {
   j = StrTrimRight(j, ",");
   j = j + "],";
}

function JsonArrElt(variable & j, variable v) void {
   if (GetType(v) == "i") j = j + IStr(v) + ",";
   if (GetType(v) == "f") j = j + FStr(v) + ",";
   if (GetType(v) == "s") j = j + "\"" + StrEscape(v) + "\",";
}

function AddJsonVariable(variable & j, variable v, variable name) void {
   JsonProp(j, name, v);
}

function AddJsonArray(variable & j, variable arr[], variable name) void {
   variable i;
   JsonArrStart(j, name);
   for (i = 0; i < arr.GetSize(); i = i + 1)
      JsonArrElt(j, arr.ElementAt(i));
   JsonArrEnd(j);
}

function AddJsonSequence(variable & j, sequence seq, variable name) void {
   variable i, jLab(""), jPos("");
   JsonObjStart(j, name);
   JsonProp(j, "current", seq.GetCurrentPosition());
   JsonProp(j, "end", seq.GetCount());
   seq.SetCurrentPosition(1);
   seq.SetCount(seq.GetTotal());
   JsonArrStart(jLab, "labware");
   JsonArrStart(jPos, "position");
   for (i = 0; i < seq.GetTotal();) {
      JsonArrElt(jLab, seq.GetLabwareId());
      JsonArrElt(jPos, seq.GetPositionId());
      seq.Increment(1);
      i = i + 1;
   }
   JsonArrEnd(jLab);
   JsonArrEnd(jPos);
   j = j + jLab + jPos;
   JsonObjEnd(j);
}

function AddJsonSequenceXyz(variable & j, sequence seq, variable name) void {
   // GetLabwarePosition is not a member of the simulated VANTAGE device and
   // makes every generated simulation method fail analysis, even when XYZ
   // sequence data is never requested. Preserve the usable sequence payload;
   // callers needing physical XYZ must query it on supported live devices.
   AddJsonSequence(j, seq, name);
}

// ----------------------------------------------------------------------------
// Frame parsing: split incoming payload at the ___SEP___ marker.
// Only cmd_id is used by the command-file transport; defs/code are retained
// for compatibility with older frame shapes.
// ----------------------------------------------------------------------------

function ParseFrame(variable strFrame,
                    variable & intCmdId,
                    variable & strDefs,
                    variable & strCode) void {
   variable intSep, strHeader, intNl;
   intSep = StrFind(strFrame, "\n___SEP___\n");
   if (intSep < 0) {
      intCmdId = 0;
      strDefs = "";
      strCode = strFrame;
      return;
   }
   strHeader = StrLeft(strFrame, intSep);
   strCode = StrMid(strFrame, intSep + StrGetLength("\n___SEP___\n"), -1);
   intNl = StrFind(strHeader, "\n");
   if (intNl < 0) {
      intCmdId = StrIVal(strHeader);
      strDefs = "";
   } else {
      intCmdId = StrIVal(StrLeft(strHeader, intNl));
      strDefs = StrMid(strHeader, intNl + 1, -1);
   }
}

// ----------------------------------------------------------------------------
// Main loop
// ----------------------------------------------------------------------------

method main()
{
   variable strFrame, strDefs, strCode;
   variable intCmdId;
   variable strContent;
   variable strScratch, strCmdFile;
   variable intStatus;
   file hdlFile;

   venusrpc::strScriptDir = HSLExtensions::File::GetDirectoryName(GetFileName());
   venusrpc::strPortFile = venusrpc::strScriptDir + "\\venusrpc.port";

   // Read port from file.
   hdlFile.AddField(1, strContent, hslString);
   hdlFile.SetDelimiter(hslAsciiText);
   hdlFile.Open(venusrpc::strPortFile, hslRead);
   hdlFile.ReadRecord();
   hdlFile.Close();
   hdlFile.RemoveFields();

   venusrpc::strBaseUrl = "http://127.0.0.1:" + strContent;
   Trace("venusrpc: base URL ", venusrpc::strBaseUrl);

   HSLHttp::Initialize(venusrpc::objHttp);
   HSLHttp::SetTimeout(venusrpc::objHttp, 10000);

   // Signal Python side that we are ready.
   HSLHttp::HttpPOST(venusrpc::objHttp, venusrpc::strBaseUrl + "/ready", "", HSLHttp::ContentType_Plaintext, intStatus);

   strScratch = "__VENUSRPC_COMMAND_PREFIX__";

   while (___SHUTDOWN___ == 0) {
      strFrame = HSLHttp::HttpGET(venusrpc::objHttp, venusrpc::strBaseUrl + "/command", intStatus);

      if (intStatus == 204) {
         // No command yet; poll again.
      } else if (intStatus != 200) {
         // HTTP error (e.g. connection refused); ignore and retry.
      } else {
         ParseFrame(strFrame, intCmdId, strDefs, strCode);

         strCmdFile = strScratch + IStr(intCmdId) + ".hsl";
         AddCheckSum(strCmdFile, "//");

         onerror goto __ERROR_HANDLER__;

         ___JSON___ = "";
         JsonObjStart(___JSON___, "");

         << strCmdFile;

         if (___ERROR___ == 0) {
            #ifdef HSL_RUNTIME
               __EvalExpr__();
            #endif
         }

         onerror goto 0;
         ___ERROR___ = 0;

         // Finalize JSON without trailing comma.
         ___JSON___ = StrTrimRight(___JSON___, ",");
         ___JSON___ = ___JSON___ + "}";

         Trace("venusrpc: result ___JSON___=", ___JSON___);

         if (StrFind(___JSON___, "\"__venusrpc_shutdown__\"") >= 0) {
            ___SHUTDOWN___ = 1;
         }

         HSLHttp::HttpPOST(venusrpc::objHttp, venusrpc::strBaseUrl + "/result", ___JSON___, HSLHttp::ContentType_JSON, intStatus);
      }
   }

   HSLHttp::Release(venusrpc::objHttp);
   return;

   __ERROR_HANDLER__:
   {
      variable strDesc;
      Trace("venusrpc: error handler fired id=", err.GetId(), " desc=", err.GetDescription());
      ___ERROR___ = 1;
      ___JSON___ = "";
      JsonObjStart(___JSON___, "");
      AddJsonVariable(___JSON___, err.GetId(), "error_id");
      strDesc = err.GetDescription();
      StrReplace(strDesc, "\n", " ");
      StrReplace(strDesc, "\r", " ");
      AddJsonVariable(___JSON___, strDesc, "error_description");
      AddJsonArray(___JSON___, err.GetData(), "error_data");
      err.Clear();
      resume next;
   }
}
